{
  "uid": "chaussec-soc",
  "title": "Chaussec - Supervision Système",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Trafic HTTP Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        { "expr": "prometheus_http_requests_total", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "barchart",
      "title": "Détections IDS (Suricata)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "elasticsearch", "uid": "elasticsearch" },
      "targets": [
        {
          "query": "alert",
          "metrics": [{ "type": "count", "id": "1" }],
          "bucketAggs": [{ "type": "date_histogram", "field": "timestamp", "id": "2", "settings": { "interval": "auto" } }],
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Scans Nmap (10h) — Ports Ouverts",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "influxdb", "uid": "influxdb" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2 }
        }
      },
      "targets": [
        {
          "refId": "A",
          "query": "from(bucket: \"chaussec_metrics\")\n  |> range(start: -10h)\n  |> filter(fn: (r) => r._measurement == \"nmap_scans\")\n  |> filter(fn: (r) => r._field == \"open_ports_count\")\n  |> keep(columns: [\"_time\", \"_value\", \"target_ip\", \"status\"])"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["soc", "chaussec"],
  "time": { "from": "now-10h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "version": 2
}
